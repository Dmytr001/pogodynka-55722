{% extends 'base.html.twig' %}

{% block title %}Measurement{% endblock %}

{% block body %}
    <h1>Measurement</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ measurement.id }}</td>
        </tr>
        <tr>
            <th>Location</th>
            <td>{{ measurement.location ? measurement.location.name : 'Brak' }}</td>
        </tr>
        <tr>
            <th>Date</th>
            <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
        </tr>
        <tr>
            <th>Temperature</th>
            <td>{{ measurement.celsius }} °C</td>
        </tr>
        <tr>
            <th>Wind speed</th>
            <td>{{ measurement.windSpeed }} km/h</td>
        </tr>
        <tr>
            <th>Humidity</th>
            <td>{{ measurement.humidity }} %</td>
        </tr>
        <tr>
            <th>Pressure</th>
            <td>{{ measurement.pressure }} hPa</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_measurement_index') }}">back to list</a>

    {% if is_granted('ROLE_MEASUREMENT_EDIT') %}
        <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">edit</a>
    {% endif %}

    {% if is_granted('ROLE_LOCATION_DELETE') %}
        {{ include('measurement/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
