{% autoescape false %}
{
    "city": "{{ city }}",
    "country": "{{ country }}",
    "measurements": [
        {%- for m in measurements %}
        {
            "date": "{{ m.date|date('Y-m-d') }}",
            "celsius": {{ m.celsius }},
            "fahrenheit": {{ m.fahrenheit }},
            "wind_speed": {{ m.windSpeed }},
            "humidity": {{ m.humidity }},
            "pressure": {{ m.pressure }}
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
    ]
}
{% endautoescape %}
